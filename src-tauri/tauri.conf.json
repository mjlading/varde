{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Varde",
  "version": "0.1.2",
  "identifier": "io.github.mjlading.varde",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Varde",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Mats Lading",
    "copyright": "Copyright (c) 2026 Mats Lading. GPL-3.0-or-later",
    "homepage": "https://github.com/mjlading/varde",
    "licenseFile": "../LICENSE",
    "targets": ["deb", "rpm", "appimage", "msi", "nsis"],
    "category": "Utility",
    "shortDescription": "One launcher for waking, streaming, and remoting into your PC.",
    "longDescription": "Varde wraps Wake-on-LAN, Moonlight game streaming, and RDP behind a single console-style launcher for your headless Windows PC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    }
  }
}
